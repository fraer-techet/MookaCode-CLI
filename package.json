{
  "name": "mookacode-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MookaCode — a local-first AI coding agent for the terminal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fraer-techet/mookacode.git"
  },
  "homepage": "https://github.com/fraer-techet/mookacode#readme",
  "bugs": {
    "url": "https://github.com/fraer-techet/mookacode/issues"
  },
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "dev": "tsx packages/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build && pnpm run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^17.13.0",
    "prettier": "^3.7.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
